@{
    ViewData["Title"] = "Index";
}

<!-- ============ HERO ============ -->
<section class="hero">
    <div class="shell hero__grid">

        <div>
            <h1 class="hero__name">
                <span><i>Saba</i></span>
                <span><i class="thin">Salukvadze</i></span>
            </h1>

            <div class="hero__role">
                <span class="bar"></span>
                <span>Full-Stack Developer</span>
                <span class="bar"></span>
                <span>C# / .NET</span>
            </div>

            <div class="hero__meta">
                <div class="stat">
                    <div class="stat__k">Focus</div>
                    <div class="stat__v">ASP.NET&nbsp;MVC &amp; APIs</div>
                </div>
                <div class="stat">
                    <div class="stat__k">Based in</div>
                    <div class="stat__v">Tbilisi, Georgia</div>
                </div>
                <div class="stat">
                    <div class="stat__k">Status</div>
                    <div class="stat__v">Open to work</div>
                </div>
            </div>
        </div>

        <div class="portrait">
            <div class="portrait__frame" data-tilt>
                <span class="portrait__corner tl"></span>
                <span class="portrait__corner br"></span>
                <img src="~/media/Qvabbyte/pfp.png"
                     alt="Saba Salukvadze"
                     onerror="this.onerror=null;this.src='/media/Qvabbyte/qvabbytefixed.png';" />
                <div class="portrait__tag">
                    <span class="brand__dot"></span>
                    <span>Athens</span>
                </div>
            </div>

            <div class="rail">
                <a href="https://github.com/Qvabby" target="_blank" rel="noopener">
                    <img src="~/media/MediaIcons/GithubIcon.png" alt="" /><span>Github</span>
                </a>
                <a href="https://stackoverflow.com/users/14074769/qvabby" target="_blank" rel="noopener">
                    <img src="~/media/MediaIcons/StackoverflowIcon.png" alt="" /><span>Stack</span>
                </a>
                <a href="https://www.linkedin.com/in/saba-salukvadze-634589268/" target="_blank" rel="noopener">
                    <img src="~/media/MediaIcons/LinkedInIcon.png" alt="" /><span>LinkedIn</span>
                </a>
            </div>
        </div>

    </div>

    <div class="cue">
        <span class="cue__line"></span>
        <span>Scroll</span>
    </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee" aria-hidden="true">
    <div class="marquee__track">
        <span>C#</span><span>.NET</span><span>Entity Framework</span><span>ASP.NET MVC</span>
        <span>REST APIs</span><span>JavaScript</span><span>TypeScript</span><span>MSSQL</span>
        <span>HTML / CSS</span><span>Java Spring</span>
    </div>
</div>

<!-- ============ INTRO ============ -->
<section class="section">
    <div class="shell">
        <div class="eyebrow"><span class="idx">01</span><span>Who</span></div>

        <p class="lede reveal">
            I build <b>things from scratch</b>. Programming, to me, is closer to an art form than
            to assembly &mdash; you make <b>something out of nothing</b>. My stack is
            <b>C# and .NET</b> on the back, whatever the job needs on the front, and
            <b>clean code</b> everywhere in between.
        </p>

        <div class="reveal" data-delay="0.1" style="margin-top:2.5rem; display:flex; flex-wrap:wrap; gap:0.6rem;">
            <a class="btn" asp-controller="Home" asp-action="AboutMe">
                <span>More about me</span><span class="btn__arrow">&rarr;</span>
            </a>
            <a class="btn btn--signal" asp-controller="Home" asp-action="CV">
                <span>Read the CV</span><span class="btn__arrow">&rarr;</span>
            </a>
        </div>
    </div>
</section>

<!-- ============ SELECTED WORK ============ -->
<section class="section">
    <div class="shell">
        <div class="eyebrow"><span class="idx">02</span><span>Selected work</span></div>

        <div class="grid">
            <a class="card reveal" href="https://wearstoneage.com" target="_blank" rel="noopener">
                <div class="card__no">001 &mdash; Live</div>
                <h3 class="card__title">StoneAge</h3>
                <p class="card__desc">
                    Streetwear brand and storefront: custom tee builder, XP loyalty feeding live
                    giveaways, bilingual EN/ქართული, admin back office.
                </p>
                <span class="card__go">wearstoneage.com <span>&rarr;</span></span>
            </a>

            <a class="card reveal" data-delay="0.08" href="https://www.amosservice.ge/" target="_blank" rel="noopener">
                <div class="card__no">002 &mdash; Live</div>
                <h3 class="card__title">Amo&rsquo;s Service</h3>
                <p class="card__desc">Towing and car services site, designed and shipped solo end to end.</p>
                <span class="card__go">amosservice.ge <span>&rarr;</span></span>
            </a>

            <a class="card reveal" data-delay="0.16" asp-controller="Home" asp-action="PublishedWorks">
                <div class="card__no">003 &mdash; Case studies</div>
                <h3 class="card__title">Published Works</h3>
                <p class="card__desc">The full breakdown &mdash; features, stack notes and links.</p>
                <span class="card__go">See the work <span>&rarr;</span></span>
            </a>
        </div>
    </div>
</section>

<!-- ============ CTA ============ -->
<section class="section">
    <div class="shell">
        <div class="eyebrow"><span class="idx">03</span><span>Next</span></div>

        <h2 class="contact__big reveal">
            Got something<br />worth building?
        </h2>

        <div class="reveal" data-delay="0.1" style="margin-top:2.6rem;">
            <a class="btn btn--signal" asp-controller="Home" asp-action="Contact">
                <span>Get in touch</span><span class="btn__arrow">&rarr;</span>
            </a>
        </div>
    </div>
</section>
