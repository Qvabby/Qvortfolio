@{
    ViewData["Title"] = "CV";
}

<div class="page">
    <section class="section">
        <div class="shell">
            <div class="eyebrow"><span class="idx">01</span><span>Curriculum vitae</span></div>

            <div class="cv">

                <div class="cv__sheet reveal">
                    <img src="~/media/Qvabbyte/SABA_SALUKVADZE_CV.png" alt="CV of Saba Salukvadze" />
                </div>

                <div class="reveal" data-delay="0.1">
                    <h1 class="h-lg">Saba Salukvadze</h1>

                    <p class="lede" style="margin-top:1.4rem;">
                        Full-stack developer working mainly in <b>C# / .NET</b> &mdash; ASP.NET MVC,
                        Entity Framework and REST APIs on the back end, HTML/CSS/JS on the front.
                        The sheet on the left is the same document you can download below.
                    </p>

                    <div class="timeline">
                        <div class="tl">
                            <div class="tl__when">Role</div>
                            <div>
                                <div class="tl__what">Full-Stack Developer</div>
                                <p class="tl__note">Back end first, front end by necessity and by choice.</p>
                            </div>
                        </div>
                        <div class="tl">
                            <div class="tl__when">Core</div>
                            <div>
                                <div class="tl__what">C# &middot; .NET &middot; EF &middot; ASP.NET MVC</div>
                                <p class="tl__note">APIs, Razor views, relational data with MSSQL.</p>
                            </div>
                        </div>
                        <div class="tl">
                            <div class="tl__when">Also</div>
                            <div>
                                <div class="tl__what">JavaScript &middot; TypeScript &middot; Java Spring</div>
                                <p class="tl__note">Used where the project called for it.</p>
                            </div>
                        </div>
                        <div class="tl">
                            <div class="tl__when">Based</div>
                            <div>
                                <div class="tl__what">Tbilisi, Georgia</div>
                                <p class="tl__note">Open to remote work and relocation.</p>
                            </div>
                        </div>
                    </div>

                    <div class="dl">
                        <a download="SABA_SALUKVADZE_CV" href="/media/Qvabbyte/SABA_SALUKVADZE_CV.pdf">
                            <span>PDF</span><span>&darr;</span>
                        </a>
                        <a download="SABA_SALUKVADZE_CV" href="/media/Qvabbyte/SABA_SALUKVADZE_CV.png">
                            <span>PNG</span><span>&darr;</span>
                        </a>
                        <a download="SABA_SALUKVADZE_CV" href="/media/Qvabbyte/SABA_SALUKVADZE_CV.jpg">
                            <span>JPG</span><span>&darr;</span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ============ EDUCATION ============ -->
    <section class="section">
        <div class="shell">
            <div class="eyebrow"><span class="idx">02</span><span>Education</span></div>

            <article class="diploma reveal">
                <div class="diploma__seal" aria-hidden="true">
                    <span>STEP</span>
                    <small>Computer<br />Academy</small>
                </div>

                <div class="diploma__body">
                    <div class="card__no">Diploma &mdash; No. TB-024273</div>
                    <h2 class="diploma__title">Computer<br />Programming</h2>
                    <p class="lede">
                        Full computer-programming course at <b>STEP Computer Academy</b>, completed
                        <b>2022&ndash;2023</b>.
                    </p>

                    <div class="specs" style="margin-top:1.6rem;">
                        <div class="spec">
                            <div class="spec__k">Institution</div>
                            <div class="spec__v">STEP Computer Academy</div>
                        </div>
                        <div class="spec">
                            <div class="spec__k">Program</div>
                            <div class="spec__v">Computer Programming</div>
                        </div>
                        <div class="spec">
                            <div class="spec__k">Years</div>
                            <div class="spec__v">2022 &ndash; 2023</div>
                        </div>
                    </div>

                    <div class="dl">
                        <a href="/media/Credentials/step-diploma-computer-programming-2023.pdf" target="_blank" rel="noopener">
                            <span>View diploma</span><span>&nearr;</span>
                        </a>
                        <a download="Saba_Salukvadze_STEP_Diploma.pdf" href="/media/Credentials/step-diploma-computer-programming-2023.pdf">
                            <span>PDF</span><span>&darr;</span>
                        </a>
                    </div>
                </div>
            </article>

            <div class="eyebrow" style="margin-top:clamp(3rem,6vw,5rem);"><span class="idx">03</span><span>Certificates</span></div>

            <div class="grid">
                <article class="card reveal">
                    <div class="card__no">2020 &mdash; STEP IT Academy</div>
                    <h3 class="card__title">Programming course &mdash; &ldquo;Profession alongside school&rdquo;</h3>
                    <div class="chips" style="margin:0.4rem 0 0.6rem;">
                        <span class="chip">HTML5 / CSS3</span>
                        <span class="chip">JavaScript</span>
                        <span class="chip">.NET &amp; C#</span>
                        <span class="chip">MS SQL Server</span>
                    </div>
                    <a class="card__go" href="/media/Credentials/step-certificate-programming-2020.pdf" target="_blank" rel="noopener">View certificate <span>&nearr;</span></a>
                </article>

                <article class="card reveal" data-delay="0.08">
                    <div class="card__no">2019 &mdash; STEP IT Academy</div>
                    <h3 class="card__title">Junior IT Academy</h3>
                    <div class="chips" style="margin:0.4rem 0 0.6rem;">
                        <span class="chip">Python</span>
                        <span class="chip">Algorithms &middot; Scratch</span>
                        <span class="chip">3D design &amp; print</span>
                        <span class="chip">BBC micro:bit</span>
                        <span class="chip">PhotoLab</span>
                        <span class="chip">Online safety</span>
                    </div>
                    <a class="card__go" href="/media/Credentials/step-certificate-junior-academy-2019.pdf" target="_blank" rel="noopener">View certificate <span>&nearr;</span></a>
                </article>
            </div>
        </div>
    </section>
</div>
