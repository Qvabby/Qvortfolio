@model List<GithubRepositoryViewModel>
@{
    ViewData["Title"] = "Github";
    var repos = Model ?? new List<GithubRepositoryViewModel>();
}

<div class="page">
    <section class="section">
        <div class="shell">
            <div class="eyebrow"><span class="idx">01</span><span>Public repositories</span></div>

            <h1 class="h-xl reveal">Source<br />code.</h1>

            <div class="filterbar reveal" data-delay="0.08" style="margin-top:clamp(2rem,4vw,3rem);">
                <label class="search">
                    <span class="search__ico">/</span>
                    <input type="search" placeholder="Filter repositories…" data-filter-input aria-label="Filter repositories" />
                </label>
                <span class="count">
                    <b data-filter-count>@repos.Count</b> / @repos.Count repos
                </span>
            </div>

            <div class="grid" data-filter-target>
                @{ var n = 0; }
                @foreach (var repository in repos)
                {
                    n++;
                    var search = ((repository.Name ?? "") + " " + (repository.Description ?? "")).ToLowerInvariant();
                    <a class="card reveal" href="@repository.HtmlUrl" target="_blank" rel="noopener" data-search="@search">
                        <div class="card__no">@n.ToString("000")</div>
                        <h3 class="card__title">@repository.Name</h3>
                        <p class="card__desc">
                            @(string.IsNullOrWhiteSpace(repository.Description) ? "No description." : repository.Description)
                        </p>
                        <span class="card__go">Open on Github <span>&rarr;</span></span>
                    </a>
                }
            </div>

            <div class="empty" data-filter-empty style="display:none;">No repository matches that filter.</div>

            @if (repos.Count == 0)
            {
                <div class="empty">No repositories to show right now.</div>
            }
        </div>
    </section>
</div>
