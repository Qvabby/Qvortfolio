@using Qvortfolio.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0c" />
    <title>@ViewData["Title"] — Saba Salukvadze</title>
    <meta name="description" content="Saba Salukvadze — full-stack developer. C#/.NET, ASP.NET MVC, JavaScript. Portfolio, CV and selected work." />

    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Qvortfolio.styles.css" asp-append-version="true" />

    <meta property="og:title" content="Saba Salukvadze — Full-Stack Developer" />
    <meta property="og:image" content="media/Qvabbyte/SABA_SALUKVADZE_CV.png" />
    <meta property="og:description" content="Full-stack developer portfolio." />
    <meta property="og:url" content="http://qvabit-001-site1.ptempurl.com/" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:type" content="website" />
</head>
<body>
    <div class="wipe" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <header class="nav">
        <div class="nav__inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand__dot"></span>
                <span>Saba Salukvadze</span>
                <span class="brand__sub">/ dev</span>
            </a>

            <nav>
                <ul class="menu" id="menu">
                    <li class="@(NavigationHelper.IsActive(ViewContext, "Home", "Index"))">
                        <a asp-area="" asp-controller="Home" asp-action="Index" data-scramble>Index</a>
                    </li>
                    <li class="@(NavigationHelper.IsActive(ViewContext, "Home", "AboutMe"))">
                        <a asp-area="" asp-controller="Home" asp-action="AboutMe" data-scramble>About</a>
                    </li>
                    <li class="@(NavigationHelper.IsActive(ViewContext, "Home", "CV"))">
                        <a asp-area="" asp-controller="Home" asp-action="CV" data-scramble>CV</a>
                    </li>
                    <li class="@(NavigationHelper.IsActive(ViewContext, "Home", "GithubRepositories"))">
                        <a asp-area="" asp-controller="Home" asp-action="GithubRepositories" data-scramble>Github</a>
                    </li>
                    <li class="@(NavigationHelper.IsActive(ViewContext, "Home", "PublishedWorks"))">
                        <a asp-area="" asp-controller="Home" asp-action="PublishedWorks" data-scramble>Work</a>
                    </li>
                    <li class="@(NavigationHelper.IsActive(ViewContext, "Home", "Contact"))">
                        <a asp-area="" asp-controller="Home" asp-action="Contact" data-scramble>Contact</a>
                    </li>
                </ul>
            </nav>

            <button class="burger" type="button" aria-label="Toggle menu" aria-controls="menu" aria-expanded="false">
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="shell">
            <div class="foot">
                <span>&copy; @DateTime.Now.Year Saba Salukvadze</span>
                <div class="foot__links">
                    <a href="https://github.com/Qvabby" target="_blank" rel="noopener">Github</a>
                    <a href="https://stackoverflow.com/users/14074769/qvabby" target="_blank" rel="noopener">Stack Overflow</a>
                    <a href="https://www.linkedin.com/in/saba-salukvadze-634589268/" target="_blank" rel="noopener">LinkedIn</a>
                    <a href="mailto:saluqvadze2006@gmail.com">Email</a>
                </div>
                <span>Tbilisi, GE</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
