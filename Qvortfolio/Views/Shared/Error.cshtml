@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page">
    <section class="section">
        <div class="shell">
            <div class="eyebrow"><span class="idx">!!</span><span>Error</span></div>

            <h1 class="h-xl">Something<br />broke.</h1>

            <p class="lede" style="margin-top:2rem;">
                An error occurred while processing your request. Nothing you did &mdash; try again,
                or head back to the start.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="count" style="margin-top:1.5rem;">Request ID: <b>@Model.RequestId</b></p>
            }

            <div style="margin-top:2.6rem;">
                <a class="btn btn--signal" asp-controller="Home" asp-action="Index">
                    <span>Back home</span><span class="btn__arrow">&rarr;</span>
                </a>
            </div>
        </div>
    </section>
</div>
